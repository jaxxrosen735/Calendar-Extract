[Unit]
Description=Toronto Screenings - Verify collation and rotate logs (oneshot)
After=network.target

[Service]
Type=oneshot
User=your_username
WorkingDirectory=/path/to/Calendar Extract
EnvironmentFile=/path/to/Calendar Extract/api.env
ExecStart=/path/to/Calendar Extract/verify_collate_and_rotate.sh
TimeoutStartSec=30m
